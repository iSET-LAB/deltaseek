Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: odom
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz_default_plugins/RobotModel
      Name: A300 + UR5e
      Enabled: true
      Description Topic:
        Value: /a300_0000/robot_description
    - Class: rviz_default_plugins/MarkerArray
      Name: Discrepancy ground truth
      Enabled: true
      Topic:
        Value: /deltaseek/ground_truth/discrepancies
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Enabled: true
  Name: root
Window Geometry:
  Height: 900
  Width: 1400

